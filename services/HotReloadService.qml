import QtQuick
import Quickshell
import qs.Commons
import "../core"
import "../lib/Model.js" as Model

// Hot reload on the iPhone (issue #13; helper `hotreload`, docs/features/hot-reload.md): a save of a Swift file
// becomes a small patch the running app loads, so the change shows in a few seconds without a rebuild.
//
// Public surface (app.hotReload):
//   setting(p) → { enabled, mode: on|off|stub, importedBy? (from status or disable) } or null (not known yet)
//   isOn(p) · forProject(p) → the entry (Model.hotReloadEntry) or null · label(p, nowMs) (Model.hotReloadLabel)
//   isLive(p) · liveCount
//   setEnabled(p, on) · toggle(p): the project switch. On: `hotreload enable`, then a session starts right away
//     (when it can: an iPhone, a bundle ID, no build of it running). Off: our session is stopped first, then
//     `hotreload disable` (which also stops someone else's session); mode stub keeps a no-op copy for views that
//     still `import HotReload` (importedBy lists them).
//   start(p) · stop(p) · restart(p) · pause(p) · resume(p) · runFix(p, fix) (fix actions hot-reload-start|stop|
//     restart|enable, else app.nav) · dismiss(p) · refresh() · startBlocker(p) ("" = it can start)
// One `hotreload run` stream per project; its snapshots go through Model.hotReloadEvent (tested in
// tests/qml/tst_hot_reload.qml). `hotreload status` (a Resource: at start-up, when the window gets focus, after
// a change) gives every project's switch and the sessions running elsewhere (another window, the MCP server);
// those are asked again every 4 s, only while one runs and the window is focused. Our own streams get
// {"cancel": true} when the app quits.
Item {
  id: root
  required property var app

  property var entries: ({})           // project path → entry
  property var settings: ({})          // project path → {enabled, mode, importedBy?}
  property int liveCount: 0

  // A switch flipped here wins over `hotreload status` until the status agrees (demo mode never does).
  property var _local: ({})
  property var _streams: ({})          // path → Stream (changed in place, not a binding)
  property var _restartAfter: ({})     // path → true: start again once this session has ended

  function _path(p) { return p && p.path ? String(p.path) : String(p || "") }
  function _project(p) {
    var path = _path(p)
    return p && p.path ? p : (app.projects ? app.projects.projectByPath(path) : null) || { path: path, name: path.split("/").pop() }
  }

  function setting(p) {
    var path = _path(p)
    return root._local[path] || root.settings[path] || null
  }
  function isOn(p) { var s = setting(p); return !!(s && s.enabled) }
  function forProject(p) { var path = _path(p); return path && root.entries[path] ? root.entries[path] : null }
  function label(p, nowMs) { return Model.hotReloadLabel(forProject(p), setting(p), nowMs === undefined ? Date.now() : nowMs) }
  function isLive(p) { return Model.hotReloadLive(forProject(p)) }

  // Why Start can't run now ("" = it can).
  function startBlocker(p) {
    var pr = _project(p)
    if (!pr.bundleId) return "It needs a bundle ID in xtool.yml first."
    if (app.projects && app.projects.blocked(pr)) return "Its xtool.yml is generated by its own scripts. Allow it in Build settings first."
    if (app.projects && !app.projects.canRun) return "Connect your iPhone first."
    if (app.projects && app.projects.building && app.projects.build.path === pr.path) return "Wait for this project's build to finish."
    return ""
  }

  function _set(path, e) {
    var copy = Object.assign({}, root.entries)
    if (e) copy[path] = e
    else delete copy[path]
    root.entries = copy
    var n = 0
    for (var k in copy) if (Model.hotReloadLive(copy[k])) n++
    root.liveCount = n
  }
  function _patch(path, fields) {
    var p = _project(path)
    var e = root.entries[path] || Model.hotReloadEntry(path, p.name)
    _set(path, Object.assign({}, e, fields))
  }
  function _setLocal(path, s) {
    var l = Object.assign({}, root._local)
    l[path] = s
    root._local = l
  }

  // ------------------------------------------------------------ the switch
  function toggle(p) { setEnabled(p, !isOn(p)) }

  function setEnabled(p, on) {
    var pr = _project(p)
    var path = pr.path
    if (!path) return
    var e = root.entries[path]
    if (e && (e.action === "enabling" || e.action === "disabling")) return
    if (on) {
      _patch(path, { action: "enabling", error: null, errorAction: "" })
      app.cli.call(["hotreload", "enable", "--project", path], "", function(d) {
        root._setLocal(path, { enabled: true, mode: "on" })
        root._patch(path, { action: "" })
        if (d && d.changed) app.toast("Hot reload is on for " + pr.name + ". iOS Studio added a few lines to Package.swift.", "ok")
        if (root.startBlocker(pr) === "") root.start(pr)
      }, function(err) {
        root._patch(path, { action: "", error: err, errorAction: "enable" })
      }, { timeout: 90000 })
      return
    }
    // Off: stop our own session first (disable also stops one another process runs, and waits for it).
    _patch(path, { action: "disabling", error: null, errorAction: "" })
    var s = root._streams[path]
    if (s) { s.quiet = true; if (!s.write({ cancel: true })) s.stop(); s.killLater() }
    delete root._restartAfter[path]
    app.cli.call(["hotreload", "disable", "--project", path], "", function(d) {
      root._setLocal(path, { enabled: false, mode: d && d.mode ? d.mode : "off", importedBy: (d && d.importedBy) || [] })
      root._set(path, null)
      var stub = d && d.mode === "stub"
      app.toast(stub ? "Hot reload is off for " + pr.name + ". Views that import HotReload keep building with a no-op copy."
                     : "Hot reload is off for " + pr.name + ".", "ok")
    }, function(err) {
      // Our session was stopped either way; one someone else runs comes back with the status.
      root._patch(path, { action: "", error: err, errorAction: "disable", session: null })
      statusRes.load(true)
    }, { timeout: 90000 })
  }

  // The files that still `import HotReload` after it was turned off (mode stub), when this window turned it off.
  function importedBy(p) { var s = setting(p); return s && s.importedBy ? s.importedBy : [] }

  // ------------------------------------------------------------ the session
  function start(p) {
    var pr = _project(p)
    var path = pr.path
    if (!path || root._streams[path] || isLive(path)) return
    var why = startBlocker(pr)
    if (why !== "") { app.toast(why, "warn"); return }
    var s = streamComp.createObject(root, { path: path })
    if (!s) { app.toast("Couldn't start iOS Studio's helper.", "error"); return }
    root._streams[path] = s
    var e = Model.hotReloadEntry(path, pr.name)
    e.action = "starting"
    _set(path, e)
    var argv = ["hotreload", "run", "--project", path]
    if (app.projects && app.projects.deviceUdid) argv.push("--udid", app.projects.deviceUdid)
    var preset = app.projects ? app.projects.selectedPreset(pr) : ""
    if (preset) argv.push("--preset", preset)
    s.start(argv)
  }

  function stop(p) {
    var path = _path(p)
    var e = root.entries[path]
    if (!e || !Model.hotReloadLive(e) || e.action === "stopping") return
    _patch(path, { action: "stopping" })
    var s = root._streams[path]
    if (s) {
      if (!s.write({ cancel: true })) s.stop()
      s.killLater()
      return
    }
    app.cli.call(["hotreload", "stop", "--project", path], "", function(d) {
      var cur = root.entries[path]
      if (cur && d && d.session) root._set(path, Model.hotReloadEvent(Object.assign({}, cur, { action: "" }),
                                                                      Object.assign({ event: "hotreload" }, d.session)))
      else if (cur) root._patch(path, { action: "" })
      root._afterEnd(path)
      statusRes.load(true)
    }, function(err) { root._patch(path, { action: "" }); app.toastError(err, "Couldn't stop hot reload") }, { timeout: 20000 })
  }

  // Stop, then start again (the fix "Run again": a full build, a new baseline).
  function restart(p) {
    var pr = _project(p)
    if (!isLive(pr.path) && !root._streams[pr.path]) { start(pr); return }
    root._restartAfter[pr.path] = true
    stop(pr)
  }

  function _afterEnd(path) {
    if (!root._restartAfter[path]) return
    delete root._restartAfter[path]
    Qt.callLater(function() { root.start(path) })
  }

  function pause(p) { _control(p, true) }
  function resume(p) { _control(p, false) }
  function _control(p, paused) {
    var path = _path(p)
    var e = root.entries[path]
    if (!e || !Model.hotReloadLive(e)) return
    _patch(path, { action: paused ? "pausing" : "resuming" })
    controlTimeout.restart()
    var s = root._streams[path]
    if (s && s.write({ cmd: paused ? "pause" : "resume" })) return
    app.cli.call(["hotreload", paused ? "pause" : "resume", "--project", path], "", function(d) {
      var cur = root.entries[path]
      if (!cur) return
      cur = Object.assign({}, cur, { action: "" })
      root._set(path, d && d.session ? Model.hotReloadEvent(cur, Object.assign({ event: "hotreload" }, d.session)) : cur)
    }, function(err) {
      root._patch(path, { action: "" })
      app.toastError(err, paused ? "Couldn't pause hot reload" : "Couldn't resume hot reload")
    }, { timeout: 15000 })
  }

  // A pause/resume the session never confirmed: let the buttons work again.
  Timer {
    id: controlTimeout
    interval: 6000
    onTriggered: {
      for (var k in root.entries) {
        var a = root.entries[k].action
        if (a === "pausing" || a === "resuming") root._patch(k, { action: "" })
      }
    }
  }

  // A helper error's fix: hot reload's own actions run here, the rest navigate (or open a URL).
  function runFix(p, fix) {
    if (!fix) return
    var a = String(fix.action || "")
    if (a === "hot-reload-restart") restart(p)
    else if (a === "hot-reload-start") start(p)
    else if (a === "hot-reload-stop") { if (isLive(p)) stop(p); else { app.cli.call(["hotreload", "stop", "--project", _path(p)], "", function() { statusRes.load(true) }, app.toastError) } }
    else if (a === "hot-reload-enable") setEnabled(p, true)
    else if (fix.url) Qt.openUrlExternally(fix.url)
    else if (fix.page) app.nav(fix.page, Object.assign({ path: _path(p) }, fix))
  }

  // Drops an error or a stopped session from the card (the switch stays as it is).
  function dismiss(p) {
    var path = _path(p)
    var e = root.entries[path]
    if (e && !Model.hotReloadLive(e) && !e.action) _set(path, null)
  }

  function refresh() { statusRes.load(true) }

  // ------------------------------------------------------------ status: the switches and others' sessions
  Resource {
    id: statusRes
    ttl: 10000
    fetch: root.app.cli.fetcher(["hotreload", "status"], "", { timeout: 20000 })
    onSucceeded: function(d) { root._applyStatus(d || {}) }
  }

  function _applyStatus(d) {
    var projects = d.projects || {}
    root.settings = projects
    // A local switch the status now agrees with is no longer needed.
    var l = Object.assign({}, root._local), changed = false
    for (var k in l) {
      var st = projects[k]
      if (st && !!st.enabled === !!l[k].enabled && (l[k].mode === st.mode || l[k].mode === undefined)) {
        // the status lists a stub project's files (importedBy) itself
        delete l[k]; changed = true
      }
    }
    if (changed) root._local = l
    var seen = {}
    var list = d.sessions || []
    for (var i = 0; i < list.length; i++) {
      var snap = list[i]
      if (!snap || !snap.path) continue
      var path = String(snap.path)
      seen[path] = true
      if (root._streams[path]) continue
      var old = root.entries[path]
      if (old && (old.action === "enabling" || old.action === "disabling")) continue
      var pr = app.projects ? app.projects.projectByPath(path) : null
      if (!old || !old.session || old.owned || old.session.pid !== snap.pid) {
        // A stopped session of ours or an old one: show only a live one, or an error it ended with.
        if (!Model.hotReloadLive({ session: snap }) && (!old || old.owned !== false)) continue
        var n = Model.hotReloadFromStatus(snap, pr ? pr.name : "")
        if (old && old.action === "stopping") n.action = "stopping"
        root._set(path, n)
      } else {
        var next = Model.hotReloadEvent(old, Object.assign({ event: "hotreload" }, snap))
        if (next !== old) root._set(path, next)
      }
    }
    // Others' sessions that ended without a final snapshot in the list (pruned): end them here.
    for (var p in root.entries) {
      var o = root.entries[p]
      if (o.owned === false && !seen[p] && Model.hotReloadLive(o))
        root._set(p, Model.hotReloadEvent(o, { event: "done", ok: true, data: { stopReason: "stopped", message: "Stopped" } }))
    }
  }

  readonly property bool _hasForeign: {
    for (var k in root.entries) { var e = root.entries[k]; if (e.owned === false && Model.hotReloadLive(e)) return true }
    return false
  }
  Timer {
    id: recheck
    interval: 4000
    repeat: true
    running: root._hasForeign && root.app.windowFocused
    onTriggered: statusRes.load(true)
  }
  Connections {
    target: root.app
    function onWindowFocusedChanged() { if (root.app.windowFocused) statusRes.load() }
  }

  // ------------------------------------------------------------ our streams
  Component {
    id: streamComp
    Stream {
      id: s
      property string path: ""
      property bool quiet: false         // turned off: its end isn't shown (the entry goes away)
      program: [root.app.helperPath]
      onEvent: function(ev) {
        if (s.quiet) return
        var e = root.entries[s.path]
        if (!e) return
        var n = Model.hotReloadEvent(e, ev)
        if (n === e) return
        root._set(s.path, n)
        root._noticeChange(e, n)
        if (ev.event === "done" && ev.ok !== true && ev.error && ev.error.code === "busy") statusRes.load(true)
      }
      onExited: function(code) {
        var e = root.entries[s.path]
        // Ended without a done event (crashed, or killed after Stop): end it here.
        if (!s.quiet && e && (Model.hotReloadLive(e) || e.action === "starting" || e.action === "stopping")) {
          root._set(s.path, e.action === "stopping"
            ? Model.hotReloadEvent(e, { event: "done", ok: true, data: { stopReason: "stopped", message: "Stopped" } })
            : Model.hotReloadEvent(e, { event: "done", ok: false, error: s.lastDone && s.lastDone.error ? s.lastDone.error
                : { code: "exited", message: "Hot reload stopped unexpectedly.",
                    fix: { label: "Start again", page: "projects", action: "hot-reload-start" } } }))
        }
        delete root._streams[s.path]
        root._afterEnd(s.path)
        Qt.callLater(function() { s.destroy() })
      }
      // After {"cancel": true} the session stops its build and ends; this only catches a hung one.
      function killLater() { kill.restart() }
      Timer { id: kill; interval: 20000; onTriggered: s.stop() }
    }
  }

  // A desktop notification when a reload fails or the session ends badly while you're in your editor.
  function _noticeChange(before, after) {
    var a = before.session ? before.session.state : "", b = after.session ? after.session.state : ""
    if (a === b || !after.session) return
    var name = after.name || after.path.split("/").pop()
    if (b === "failed")
      app.notify("Hot reload: " + name + " didn't reload", Model.errorMessage(after.session.lastError || after.session.message), Model.Glyph.hotReload)
    else if (b === "stopped" && after.session.stopReason !== "stopped" && after.session.lastError)
      app.notify("Hot reload stopped: " + name, Model.errorMessage(after.session.lastError), Model.Glyph.hotReload)
  }

  Component.onCompleted: statusRes.load()
  Component.onDestruction: {
    for (var k in root._streams) { var s = root._streams[k]; if (s && s.running) s.write({ cancel: true }) }
  }
}
