import QtQuick
import QtQuick.Effects
import QtQuick.Layouts
import qs.Commons
import qs.Commons as Commons
import qs.Ui
import "../common"
import "../../lib/Model.js" as Model

// "Set icon…" sheet (projects slice): makes the app icon from any image. Choose image runs the helper's
// file dialog (`projects pick-file --kind image`); every choice renders a dry run (`projects icon`,
// ProjectService.previewIcon) to a preview PNG in the cache, shown inside a Home Screen style rounded
// mask. iOS rounds the corners itself, so the saved file stays square (the caption says so). Background
// (swatches or a hex field) and fit (Auto/Fill/Fit) re-render it, debounced. "Set icon" repeats the same
// call with --confirm (setIcon): the 1024×1024 PNG is written, iconPath set, the list refreshed.
// States: no image yet, rendering, helper error (message + fix), warnings from the reply.
//   ProjectIconSheet { id: iconSheet; app: page.app; svc: page.svc }
//   iconSheet.openFor(project)
Sheet {
  id: root

  property var app: null
  property var svc: null
  property var project: ({})

  property string image: ""              // the chosen source image (absolute path)
  property string fit: "auto"
  property string background: "#ffffff"
  property var result: null              // the last dry run's `data`
  property var error: null               // pick/preview/apply failure (helper error object)
  property bool previewing: false
  property bool applying: false
  property int revision: 0               // bumps the preview URL: the helper may reuse its file name
  property int _ticket: 0                // drops answers for an older request or a closed sheet

  // Background swatches: icon colours, not theme colours (they end up in the PNG).
  readonly property var swatches: ["#ffffff", "#000000", "#1c1c1e", "#f2f2f7", "#0a84ff", "#30d158", "#ff9f0a", "#ff375f"]
  readonly property bool hexValid: Model.hexColor(hexField.text) !== ""
  readonly property bool hasAlpha: !!(result && result.source && result.source.hasAlpha)
  readonly property string resolvedFit: result && result.fit ? result.fit : ""
  // The background only shows through transparency or Fit's margin.
  readonly property bool backgroundMatters: !result || hasAlpha || resolvedFit === "fit"
  readonly property var warnings: result && result.warnings ? result.warnings : []

  readonly property string blocker: project && project.generated ? "This project's xtool.yml is generated by its own scripts. Set iconPath in the script that writes it."
                                    : image === "" ? "Choose an image first"
                                    : !hexValid ? "The background needs a hex color like #1e90ff"
                                    : previewing ? "Still rendering the preview"
                                    : error ? "Fix the problem above first"
                                    : !result ? "No preview yet"
                                    : ""

  title: "App icon"
  subtitle: project && project.name ? "Make " + project.name + "'s Home Screen icon from any image." : ""
  glyph: Model.Glyph.image
  preferredWidth: Style.space(720)
  busy: applying

  function openFor(p) {
    root.project = p || {}
    root.image = ""
    root.fit = "auto"
    root.background = "#ffffff"
    hexField.text = "#ffffff"
    root.result = null
    root.error = null
    root.previewing = false
    root.applying = false
    root._ticket++
    root.open()
  }

  function choose() {
    root.svc.pickImage(function(path) {
      if (!path || !root.opened) return
      root.image = path
      root.result = null
      root.render()
    })
  }

  function opts() { return { image: root.image, background: root.background, fit: root.fit } }

  function render() {
    debounce.stop()
    if (root.image === "" || !root.hexValid) return
    var t = ++root._ticket
    root.previewing = true
    root.error = null
    root.svc.previewIcon(root.project, root.opts(), function(d) {
      if (t !== root._ticket) return
      root.previewing = false
      root.result = d
      root.revision++
    }, function(e) {
      if (t !== root._ticket) return
      root.previewing = false
      root.error = e
    })
  }

  function apply() {
    if (root.blocker !== "" || root.applying) return
    var t = ++root._ticket
    root.applying = true
    root.error = null
    root.svc.setIcon(root.project, root.opts(), function() {
      if (t !== root._ticket) return
      root.applying = false
      root.close()
    }, function(e) {
      if (t !== root._ticket) return
      root.applying = false
      root.error = e
    })
  }

  function pickBackground(c) {
    hexField.text = c
    root.background = c
    debounce.restart()
  }

  function shortPath(p) { return String(p || "").replace(root.app ? root.app.home : "", "~") }
  function fileName(p) { return String(p || "").split("/").pop() }

  function sourceLine() {
    var s = root.result && root.result.source
    if (!s) return root.previewing ? "Reading the image…" : ""
    var parts = [s.width + "×" + s.height]
    if (s.format) parts.push(String(s.format).toUpperCase())
    if (s.hasAlpha) parts.push("has transparency")
    return parts.join(" · ")
  }

  function fitNote() {
    if (root.fit === "fill") return "Fills the square and crops what sticks out. Good for photos."
    if (root.fit === "fit") return "Shows the whole image on the background, with a margin. Good for logos."
    if (!root.resolvedFit) return "Fit for images with transparency (logos), Fill for the rest."
    return root.resolvedFit === "fit" ? "Using Fit: the image has transparency." : "Using Fill: the image has no transparency."
  }

  function changeLine() {
    var r = root.result
    if (!r || !r.target) return ""
    var what = r.replaces ? "Replaces " + r.target : "Saves " + r.target
    if (r.yml === "add") return what + " and adds iconPath to xtool.yml."
    if (r.yml === "change") return what + " and points iconPath at it (it was " + (r.previous || "another file") + ")."
    return what + ". xtool.yml already points at it."
  }

  onClosed: { root._ticket++; root.previewing = false; root.applying = false; debounce.stop() }

  Timer { id: debounce; interval: 350; onTriggered: root.render() }

  ErrorState {
    Layout.fillWidth: true
    visible: root.error !== null
    app: root.app
    banner: true
    error: root.error
    retryText: "Try again"
    showRetry: root.image !== ""
    onRetry: root.render()
    onFixed: root.close()
  }

  AppText {
    Layout.fillWidth: true
    visible: !!root.project.generated
    text: "This project's xtool.yml is generated by its own scripts, so iOS Studio won't edit it. You can still preview here; set iconPath in the script that writes xtool.yml."
    tone: "warn"; size: "small"; wrapMode: Text.Wrap
  }

  GridLayout {
    id: grid
    Layout.fillWidth: true
    columns: width >= Style.space(560) ? 2 : 1
    columnSpacing: Style.spacing.huge
    rowSpacing: Style.spacing.xl

    // ---------------------------------------------------------------- preview
    ColumnLayout {
      id: previewCol
      // one column (narrow): stays on the left, as wide as the tile, above the controls
      Layout.alignment: Qt.AlignTop | Qt.AlignLeft
      Layout.preferredWidth: Style.space(200)
      Layout.maximumWidth: Style.space(200)
      spacing: Style.spacing.lg

      Item {
        id: tile
        Layout.preferredWidth: Style.space(200)
        Layout.preferredHeight: Style.space(200)
        // iOS's icon corner is about 22% of the side (a superellipse; a rounded rect is close enough here)
        readonly property real cornerRadius: width * 0.2237
        readonly property bool hasPreview: !!root.result && !!root.result.preview && previewImg.status === Image.Ready

        Rectangle {
          id: tileMask
          anchors.fill: parent
          radius: tile.cornerRadius
          visible: false
          layer.enabled: true
          layer.smooth: true
        }

        // empty / loading placeholder
        Rectangle {
          anchors.fill: parent
          visible: !tile.hasPreview
          radius: tile.cornerRadius
          color: Theme.surface
          border.width: Style.normalBorderWidth
          border.color: Theme.hairline
          ColumnLayout {
            anchors.centerIn: parent
            width: parent.width - Style.spacing.xxl * 2
            spacing: Style.spacing.md
            Spinner { Layout.alignment: Qt.AlignHCenter; visible: root.previewing; running: visible }
            Icon { Layout.alignment: Qt.AlignHCenter; visible: !root.previewing; glyph: Model.Glyph.imagePlus; size: Style.font.display; color: Theme.faint }
            AppText {
              Layout.fillWidth: true
              horizontalAlignment: Text.AlignHCenter
              wrapMode: Text.Wrap
              size: "small"; tone: "faint"
              text: root.previewing ? "Rendering…" : root.image === "" ? "No image yet" : "No preview"
            }
          }
        }

        Item {
          anchors.fill: parent
          visible: tile.hasPreview
          opacity: root.previewing ? 0.55 : 1
          Behavior on opacity { NumberAnimation { duration: 120 } }
          layer.enabled: true
          layer.effect: MultiEffect { maskEnabled: true; maskSource: tileMask; maskThresholdMin: 0.5; maskSpreadAtMin: 1.0 }
          Image {
            id: previewImg
            anchors.fill: parent
            asynchronous: true
            cache: false
            smooth: true
            mipmap: true
            fillMode: Image.PreserveAspectFit
            sourceSize.width: Math.round(tile.width * 2)
            sourceSize.height: Math.round(tile.height * 2)
            source: root.result && root.result.preview ? Util.fileUrl(root.result.preview) + "?v=" + root.revision : ""
          }
        }
        // a hairline edge, so a white icon still reads on a light theme
        Rectangle {
          anchors.fill: parent
          visible: tile.hasPreview
          radius: tile.cornerRadius
          color: "transparent"
          border.width: Style.normalBorderWidth
          border.color: Theme.hairline
        }
        Spinner {
          anchors.centerIn: parent
          visible: tile.hasPreview && root.previewing
          running: visible
        }
      }

      AppText {
        Layout.fillWidth: true
        text: "iOS rounds the corners itself. The saved file stays square, 1024×1024."
        size: "small"; tone: "faint"; wrapMode: Text.Wrap
      }

      // the icon the project has now
      RowLayout {
        Layout.fillWidth: true
        spacing: Style.spacing.lg
        Rectangle {
          id: currentTile
          Layout.preferredWidth: Style.space(40)
          Layout.preferredHeight: Style.space(40)
          radius: width * 0.2237
          color: Theme.surface
          border.width: Style.normalBorderWidth
          border.color: Theme.hairline
          clip: true
          Image {
            id: currentImg
            anchors.fill: parent
            visible: status === Image.Ready
            asynchronous: true
            cache: false
            fillMode: Image.PreserveAspectCrop
            sourceSize.width: Style.space(80)
            sourceSize.height: Style.space(80)
            source: root.opened && root.project.icon ? Util.fileUrl(root.project.icon) : ""
            layer.enabled: visible
            layer.effect: MultiEffect { maskEnabled: true; maskSource: currentMask; maskThresholdMin: 0.5; maskSpreadAtMin: 1.0 }
          }
          Rectangle { id: currentMask; anchors.fill: parent; radius: parent.radius; visible: false; layer.enabled: true; layer.smooth: true }
          Icon { anchors.centerIn: parent; visible: !currentImg.visible; glyph: Model.Glyph.image; size: Style.font.icon; color: Theme.faint }
        }
        ColumnLayout {
          Layout.fillWidth: true
          spacing: 0
          AppText { Layout.fillWidth: true; text: "Now"; size: "small"; tone: "dim" }
          AppText {
            Layout.fillWidth: true
            text: root.project.icon ? root.fileName(root.project.icon) : "No icon yet"
            size: "small"; tone: root.project.icon ? "primary" : "faint"; elide: Text.ElideMiddle
          }
        }
      }
    }

    // ---------------------------------------------------------------- controls
    ColumnLayout {
      Layout.fillWidth: true
      Layout.alignment: Qt.AlignTop
      spacing: Style.spacing.xxl

      // image
      ColumnLayout {
        Layout.fillWidth: true
        spacing: Style.spacing.sm
        AppText { text: "Image"; strong: true }
        RowLayout {
          Layout.fillWidth: true
          spacing: Style.spacing.lg
          ColumnLayout {
            Layout.fillWidth: true
            spacing: 0
            AppText {
              Layout.fillWidth: true
              text: root.image !== "" ? root.fileName(root.image) : "PNG, JPEG, WebP, HEIC, SVG and more"
              tone: root.image !== "" ? "primary" : "faint"
              elide: Text.ElideMiddle
            }
            AppText {
              Layout.fillWidth: true
              visible: text !== ""
              text: root.sourceLine()
              size: "small"; tone: "dim"; elide: Text.ElideRight
            }
          }
          ActionButton {
            text: root.image !== "" ? "Change…" : "Choose image…"
            glyph: Model.Glyph.folderOpen
            compact: true
            kind: root.image !== "" ? "ghost" : "secondary"
            enabled: !root.applying
            onClicked: root.choose()
          }
        }
      }

      // fit
      ColumnLayout {
        Layout.fillWidth: true
        spacing: Style.spacing.sm
        AppText { text: "Fit"; strong: true }
        ButtonGroup {
          options: [{ value: "auto", label: "Auto" }, { value: "fill", label: "Fill" }, { value: "fit", label: "Fit" }]
          value: root.fit
          onChanged: function(v) { root.fit = v; debounce.restart() }
        }
        AppText { Layout.fillWidth: true; text: root.fitNote(); size: "small"; tone: "faint"; wrapMode: Text.Wrap }
      }

      // background
      ColumnLayout {
        Layout.fillWidth: true
        spacing: Style.spacing.sm
        AppText { text: "Background"; strong: true }
        Flow {
          Layout.fillWidth: true
          spacing: Style.spacing.md
          Repeater {
            model: root.swatches
            // as tall as the hex field, so the circles sit on its centre line
            delegate: Item {
              id: sw
              required property string modelData
              readonly property bool sel: root.background === modelData
              width: Style.space(28)
              height: hexField.height
              Rectangle {
                anchors.centerIn: parent
                width: parent.width
                height: width
                radius: width / 2
                color: "transparent"
                border.width: sw.sel ? Style.normalBorderWidth * 2 : 0
                border.color: Commons.Color.accent
                Rectangle {
                  anchors.centerIn: parent
                  width: parent.width - Style.space(6)
                  height: width
                  radius: width / 2
                  color: sw.modelData
                  border.width: Style.normalBorderWidth
                  border.color: swHover.hovered && !sw.sel ? Theme.faint : Theme.hairline
                }
              }
              HoverHandler { id: swHover; cursorShape: Qt.PointingHandCursor }
              TapHandler { onTapped: root.pickBackground(sw.modelData) }
            }
          }
          TextField {
            id: hexField
            width: Style.space(120)
            placeholderText: "#ffffff"
            text: "#ffffff"
            onTextEdited: {
              var c = Model.hexColor(text)
              if (c === "") return
              root.background = c
              debounce.restart()
            }
            onAccepted: { var c = Model.hexColor(text); if (c !== "") { text = c; root.background = c; root.render() } }
          }
        }
        AppText {
          Layout.fillWidth: true
          text: !root.hexValid ? "Use a hex color like #1e90ff."
                : root.backgroundMatters ? "Fills transparent parts and Fit's margin. iOS shows transparency as black, so the icon never keeps any."
                : "This image has no transparency and fills the square, so the background doesn't show."
          size: "small"; tone: !root.hexValid ? "warn" : "faint"; wrapMode: Text.Wrap
        }
      }

      // warnings from the dry run
      Repeater {
        model: root.warnings
        delegate: RowLayout {
          id: warnRow
          required property string modelData
          Layout.fillWidth: true
          spacing: Style.spacing.lg
          FontMetrics { id: warnMetrics; font: warnText.font }
          Item {
            Layout.alignment: Qt.AlignTop
            Layout.preferredWidth: warnIcon.implicitWidth
            Layout.preferredHeight: warnMetrics.height
            Icon { id: warnIcon; anchors.centerIn: parent; glyph: Model.Glyph.warn; color: Theme.warn; size: Style.font.icon }
          }
          AppText { id: warnText; Layout.fillWidth: true; text: warnRow.modelData; size: "small"; tone: "warn"; wrapMode: Text.Wrap }
        }
      }

      // what Set icon changes
      AppText {
        Layout.fillWidth: true
        visible: text !== ""
        text: root.changeLine()
        size: "small"; tone: "dim"; wrapMode: Text.Wrap
      }
    }
  }

  footer: [
    ActionButton { text: "Cancel"; kind: "ghost"; enabled: !root.applying; onClicked: root.close() },
    ActionButton {
      text: "Set icon"
      glyph: Model.Glyph.checkCircle
      kind: "primary"
      busy: root.applying
      disabled: root.blocker !== ""
      tooltip: root.blocker !== "" ? root.blocker : "Save the 1024×1024 PNG in the project and point xtool.yml at it"
      onClicked: root.apply()
    }
  ]
}
