import QtQuick
import QtQuick.Layouts
import qs.Commons
import qs.Commons as Commons
import qs.Ui
import "../common"
import "../../lib/Model.js" as Model

// One app project on the Projects page (projects slice).
//   ProjectCard { project: modelData; svc: app.projects; hasCursor: …; onRun: … }
// Run is the card's primary action; the rest live behind "More", which expands in place.
// Run is a split button (RunSplitButton): its chevron picks the run preset (launch arguments,
// environment, language) Run uses, and "Edit presets…" there or under More emits editPresets() (the
// page opens RunPresetsSheet). A selected preset shows as a quiet "Runs with …" after the bundle ID.
// Below the details, ProjectCheckView shows the project settings check (`projects check`): a
// warnings summary that expands to the issues; a clean result shows only while "More" is open.
// The card asks for a check when it appears and when it gets the cursor (skipped while fresh).
// Editor setup is machine-wide (Settings › Code editor). The card only ends its path line with a quiet
// hint when completion can't work in this project yet (e.g. "Build once to enable completion");
// nothing shows when it's ready.
// Watch mode (compile on save, `watch`): turned on in the Run menu (▾), with "Run after each clean
// compile". While this project is watched, the title row's last-build pill becomes the watch state
// (WatchStateLabel: "Watching · compiled 12 s ago" / "Compiling…" / "Watching · 2 errors"); clicking
// it emits showProblems(). Nothing is added to the right-hand cluster.
// Format and lint (`format`, `format-lint`): "Format project…" and "Lint project" sit under More, next to
// Check build. Format opens ProjectFormatSheet (formatProject()); Lint shows the style warnings in the
// build panel's Problems (lintProject()). While a lint runs, its button spins; its tooltip has the last count.
// Swift packages (`packages`): "Packages…" under More opens ProjectPackagesSheet (managePackages()).
BorderSurface {
  id: root

  property var project: ({})
  property var svc: null
  property var watchSvc: null           // app.watch (WatchService)
  property bool hasCursor: false
  property bool expanded: false
  readonly property bool isBuilding: !!(svc && svc.building && svc.build.path === project.path)
  readonly property bool otherBuilding: !!(svc && svc.building && !isBuilding)
  readonly property var last: project.lastBuild || null
  readonly property var signing: project.signing || null
  readonly property bool hot: hasCursor || hover.hovered
  readonly property bool narrow: width < Style.space(640)
  // A generated xtool.yml is only built once the project's build settings allow it.
  readonly property bool blocked: !!project.generated && !(project.buildSettings && project.buildSettings.allowGenerated)
  readonly property string runPreset: svc ? svc.selectedPreset(project) : (project.runPreset || "")
  readonly property var watchState: watchSvc ? watchSvc.forProject(project) : null
  readonly property var watchInfo: watchState && watchSvc ? watchSvc.label(watchState) : null
  readonly property var lintEntry: svc ? svc.lintFor(project) : null
  readonly property string lintTip: {
    var base = "Check the code style with swift-format (and SwiftLint when it's installed). Results show in Problems. (L)"
    var e = root.lintEntry
    if (!e || !e.result || e.state === "error") return base
    var r = e.result
    var n = r.total !== undefined ? r.total : (r.diagnostics || []).length
    return base + "\nLast check: " + (n ? Model.plural(n, "style warning") : "no style warnings") + ", " + Model.relativeTime(e.at) + "."
  }
  readonly property string blockedTip: "Its xtool.yml is generated by its own scripts. Allow it in Build settings (under More)."

  signal run()
  signal buildIpa()
  signal checkBuild()
  signal renew()
  signal openEditor()
  signal openFolder()
  signal removeFromList()
  signal toggleAutoRenew()
  signal openBuildSettings()
  signal editPresets()
  signal showBuild()
  signal showProblems()
  signal formatProject()
  signal lintProject()
  signal managePackages()
  signal hovered(bool h)

  radius: Style.cornerRadius
  color: hot ? Theme.surfaceRaised : Theme.surface
  borderSpec: Border.flat(isBuilding || hasCursor ? Util.alpha(Commons.Color.accent, hasCursor ? 0.75 : 0.55)
                                       : (hover.hovered ? Util.alpha(Commons.Color.foreground, 0.22) : Theme.hairline), Style.normalBorderWidth)
  padding: Style.spacing.panelPadding
  implicitHeight: col.implicitHeight + contentTopInset + contentBottomInset
  Behavior on color { ColorAnimation { duration: 140 } }

  HoverHandler { id: hover; onHoveredChanged: root.hovered(hovered) }
  Component.onCompleted: if (svc && project.path) { svc.checkSoon(project); svc.editorStatusSoon(project) }
  onHasCursorChanged: if (hasCursor && svc && project.path) svc.checkSoon(project)
  onExpandedChanged: if (expanded && svc && project.path) svc.checkSoon(project)

  function lastBuildPill() {
    if (!last) return null
    var kind = { run: "Ran", renew: "Re-signed", ipa: "Built .ipa", install: "Reinstalled", compile: "Built" }[last.kind] || "Built"
    if (Model.isWatchBuild(last) && last.kind === "compile") kind = "Compiled on save"
    if (last.result === "ok") return { level: "ok", text: kind + " " + Model.relativeTime(last.time) }
    if (last.result === "cancelled") return { level: "info", text: "Cancelled " + Model.relativeTime(last.time) }
    var e = last.errors > 0 ? " · " + Model.plural(last.errors, "error") : ""
    return { level: "error", text: "Failed " + Model.relativeTime(last.time) + e }
  }

  // The path line's editor hint (`editor status --project`): text when completion isn't ready yet, else "".
  readonly property string editorHint: {
    var e = svc ? svc.editorFor(project) : null
    var r = e && e.state === "ready" ? e.result : null
    return r && r.ready === false && r.hint ? String(r.hint) : ""
  }

  function signingPill() {
    if (!signing || signing.daysLeft === null || signing.daysLeft === undefined) return null
    var d = signing.daysLeft
    if (d <= 0) return { level: "error", text: "Signing expired" }
    if (d < 1) return { level: "warn", text: "Expires in " + Math.max(1, Math.round(d * 24)) + " h" }
    if (d < 2) return { level: "warn", text: "Expires tomorrow" }
    return { level: "ok", text: Math.floor(d) + " days left" }
  }

  ColumnLayout {
    id: col
    anchors.fill: parent
    anchors.topMargin: root.contentTopInset
    anchors.bottomMargin: root.contentBottomInset
    anchors.leftMargin: root.contentLeftInset
    anchors.rightMargin: root.contentRightInset
    spacing: Style.spacing.lg

    GridLayout {
      Layout.fillWidth: true
      columns: root.narrow ? 2 : 3
      columnSpacing: Style.spacing.xxl
      rowSpacing: Style.spacing.lg

      // App icon, or a monogram tile
      Rectangle {
        Layout.preferredWidth: Style.space(48)
        Layout.preferredHeight: Style.space(48)
        Layout.alignment: Qt.AlignTop
        radius: Style.cornerRadius + Style.space(4)
        color: Util.alpha(Commons.Color.accent, 0.14)
        border.width: Style.normalBorderWidth
        border.color: Util.alpha(Commons.Color.accent, 0.28)
        clip: true
        Image {
          id: iconImg
          anchors.fill: parent
          visible: status === Image.Ready
          source: Util.fileUrl(root.project.icon)
          sourceSize.width: Style.space(96)
          sourceSize.height: Style.space(96)
          fillMode: Image.PreserveAspectCrop
          asynchronous: true
          smooth: true
        }
        AppText {
          anchors.centerIn: parent
          visible: !iconImg.visible
          text: String(root.project.name || "?").replace(/[^A-Za-z0-9]/g, "").substring(0, 2).toUpperCase() || "?"
          size: "title"
          strong: true
          tone: "accent"
        }
      }

      ColumnLayout {
        Layout.fillWidth: true
        spacing: Style.spacing.xs

        RowLayout {
          Layout.fillWidth: true
          spacing: Style.spacing.lg
          AppText {
            text: root.project.name || ""
            size: "title"
            strong: true
            elide: Text.ElideRight
            Layout.fillWidth: true
            Layout.maximumWidth: implicitWidth + 1
            // the watch state beside it elides first
            Layout.minimumWidth: root.watchInfo !== null ? Math.min(implicitWidth + 1, Style.space(140)) : 0
          }
          StatusPill {
            readonly property var pill: root.isBuilding ? { level: "busy", text: "Building…" } : root.lastBuildPill()
            visible: pill !== null && (root.isBuilding || root.watchInfo === null)
            level: pill ? pill.level : "info"
            text: pill ? pill.text : ""
            quiet: true
          }
          // Watch mode: replaces the last-build pill while this project is watched; gives way (elides) first.
          WatchStateLabel {
            Layout.fillWidth: true
            Layout.maximumWidth: implicitWidth + 1
            Layout.minimumWidth: Style.space(60)
            Layout.horizontalStretchFactor: 100
            visible: root.watchInfo !== null && !root.isBuilding
            info: root.watchInfo
            onClicked: root.showProblems()
          }
          Item { Layout.fillWidth: true }
        }
        // Bundle ID, then the selected run preset (only when there is one). The preset gives way
        // first: it elides before the bundle ID does.
        RowLayout {
          Layout.fillWidth: true
          spacing: Style.spacing.md
          AppText {
            Layout.fillWidth: true
            Layout.maximumWidth: implicitWidth + 1
            text: root.project.bundleId || "No bundle ID in xtool.yml"
            tone: root.project.bundleId ? "dim" : "warn"
            size: "small"
            elide: Text.ElideRight
          }
          AppText {
            visible: root.runPreset !== ""
            text: "·"
            tone: "faint"
            size: "small"
          }
          AppText {
            Layout.fillWidth: true
            Layout.maximumWidth: implicitWidth + 1
            Layout.minimumWidth: 0
            Layout.horizontalStretchFactor: 100
            visible: root.runPreset !== ""
            text: "Runs with " + root.runPreset
            tone: "faint"
            size: "small"
            elide: Text.ElideRight
          }
          Item { Layout.fillWidth: true }
        }
        RowLayout {
          Layout.fillWidth: true
          spacing: Style.spacing.lg
          Icon { glyph: Model.Glyph.folder; size: Style.font.bodySmall; color: Theme.faint }
          // The branch follows the path (the path only takes what it needs), so it sits in the same
          // place whether or not the card shows a signing badge on the right.
          AppText { text: root.project.displayPath || ""; tone: "faint"; size: "small"; elide: Text.ElideMiddle; Layout.fillWidth: true; Layout.maximumWidth: implicitWidth + 1; Layout.minimumWidth: Style.space(60) }
          Icon { visible: !!root.project.branch; glyph: Model.Glyph.link; size: Style.font.bodySmall; color: Theme.faint; Layout.leftMargin: Style.spacing.md }
          AppText { visible: !!root.project.branch; text: root.project.branch || ""; tone: "faint"; size: "small"; elide: Text.ElideRight; Layout.maximumWidth: Style.space(160) }
          // Editor hint: only when completion isn't ready here yet (quiet; gives way first)
          Icon {
            visible: root.editorHint !== "" && !root.narrow
            glyph: Model.Glyph.fileCode
            size: Style.font.bodySmall
            color: Theme.faint
            Layout.leftMargin: Style.spacing.md
          }
          AppText {
            visible: root.editorHint !== "" && !root.narrow
            text: root.editorHint
            tone: "faint"; size: "small"; elide: Text.ElideRight
            Layout.fillWidth: true
            Layout.maximumWidth: Math.min(implicitWidth + 1, Style.space(260))
            Layout.minimumWidth: 0
          }
          Item { Layout.fillWidth: true }
        }
        // Narrow cards: the editor hint gets its own line, so it doesn't squeeze the path
        RowLayout {
          Layout.fillWidth: true
          visible: root.editorHint !== "" && root.narrow
          spacing: Style.spacing.lg
          Icon { glyph: Model.Glyph.fileCode; size: Style.font.bodySmall; color: Theme.faint }
          AppText { Layout.fillWidth: true; text: root.editorHint; tone: "faint"; size: "small"; elide: Text.ElideRight }
        }
      }

      // Right cluster: signing badge, More, Run. One height (Run's) and one vertical centre.
      RowLayout {
        Layout.columnSpan: root.narrow ? 2 : 1
        Layout.alignment: Qt.AlignRight | Qt.AlignVCenter
        spacing: Style.spacing.xl
      StatusPill {
        Layout.preferredHeight: runSplit.implicitHeight
        readonly property var pill: root.signingPill()
        visible: pill !== null && !root.isBuilding
        level: pill ? pill.level : "info"
        text: pill ? pill.text : ""
        glyph: Model.Glyph.signature
        Layout.alignment: Qt.AlignVCenter
      }

      IconButton {
        Layout.alignment: Qt.AlignVCenter
        Layout.preferredHeight: runSplit.implicitHeight
        Layout.preferredWidth: runSplit.implicitHeight
        glyph: root.expanded ? Model.Glyph.chevronUp : Model.Glyph.dots
        tooltip: root.expanded ? "Fewer actions" : "More actions"
        onClicked: root.expanded = !root.expanded
      }

      RunSplitButton {
        id: runSplit
        Layout.alignment: Qt.AlignVCenter
        visible: !root.isBuilding
        project: root.project
        svc: root.svc
        watchSvc: root.watchSvc
        watchBlocker: root.blocked ? "allow it in Build settings" : ""
        disabled: root.otherBuilding || root.blocked
        tooltip: root.blocked ? root.blockedTip
                 : root.otherBuilding ? "Another build is running. Wait for it or cancel it first."
                 : (root.svc && !root.svc.canRun ? "Connect your iPhone first"
                 : "Build, install and open on your iPhone" + (root.runPreset ? " with “" + root.runPreset + "”" : "") + " (Enter)")
        onRun: root.run()
        onEditRequested: root.editPresets()
      }
      ActionButton {
        Layout.alignment: Qt.AlignVCenter
        visible: root.isBuilding
        text: "View build"
        glyph: Model.Glyph.chevronRight
        onClicked: root.showBuild()
      }
      }
    }

    // Live progress while this project builds
    ProgressTrack {
      Layout.fillWidth: true
      visible: root.isBuilding
      value: root.svc ? root.svc.build.fraction || 0 : 0
      indeterminate: root.svc ? !(root.svc.build.fraction > 0) : true
      label: root.svc ? root.svc.build.detail || "" : ""
      trailing: root.svc && root.svc.build.eta ? "about " + Model.formatDuration(root.svc.build.eta) + " left" : ""
    }

    AppText {
      Layout.fillWidth: true
      visible: !!root.project.note
      text: root.project.note || ""
      tone: "warn"
      size: "small"
      wrapMode: Text.WordWrap
    }

    ProjectCheckView {
      Layout.fillWidth: true
      project: root.project
      svc: root.svc
      showClean: root.expanded
    }

    // More actions, expanded in place
    Rectangle { Layout.fillWidth: true; visible: root.expanded; height: Style.normalBorderWidth; color: Theme.hairline }
    Flow {
      Layout.fillWidth: true
      visible: root.expanded
      spacing: Style.spacing.md
      ActionButton { text: "Check build"; glyph: Model.Glyph.hammer; kind: "ghost"; compact: true; enabled: !root.svc.building && !root.blocked; tooltip: "Compile for iPhone without signing or installing (Shift+B)"; onClicked: root.checkBuild() }
      ActionButton { text: "Format project…"; glyph: Model.Glyph.format; kind: "ghost"; compact: true; tooltip: "See what swift-format would change, then apply it (F)"; onClicked: root.formatProject() }
      ActionButton { text: "Lint project"; glyph: Model.Glyph.lint; kind: "ghost"; compact: true; busy: !!(root.lintEntry && root.lintEntry.state === "loading"); tooltip: root.lintTip; onClicked: root.lintProject() }
      ActionButton { text: "Packages…"; glyph: Model.Glyph.packages; kind: "ghost"; compact: true; tooltip: "Add, update or remove the Swift packages it depends on (P)"; onClicked: root.managePackages() }
      ActionButton { text: "Build .ipa"; glyph: Model.Glyph.package; kind: "ghost"; compact: true; enabled: !root.svc.building && !root.blocked; tooltip: "Build and sign an installable .ipa file"; onClicked: root.buildIpa() }
      ActionButton { text: "Re-sign & reinstall"; glyph: Model.Glyph.sync; kind: "ghost"; compact: true; enabled: !root.svc.building && !root.blocked; tooltip: "Free Apple IDs sign apps for 7 days. This renews it for another week."; onClicked: root.renew() }
      ActionButton { text: root.project.autoRenew ? "Auto-renew: on" : "Auto-renew: off"; glyph: Model.Glyph.timer; kind: "ghost"; compact: true; tooltip: "Re-sign this app automatically before it expires"; onClicked: root.toggleAutoRenew() }
      ActionButton { text: "Run presets"; glyph: Model.Glyph.tune; kind: "ghost"; compact: true; tooltip: "Edit the launch arguments, environment variables and language Run can use"; onClicked: root.editPresets() }
      ActionButton { text: "Build settings"; glyph: Model.Glyph.wrench; kind: "ghost"; compact: true; tooltip: "Prebuild command, environment variables, open-file limit"; onClicked: root.openBuildSettings() }
      ActionButton { text: "Open in editor"; glyph: Model.Glyph.code; kind: "ghost"; compact: true; onClicked: root.openEditor() }
      ActionButton { text: "Open folder"; glyph: Model.Glyph.folderOpen; kind: "ghost"; compact: true; onClicked: root.openFolder() }
      ActionButton { text: "Remove from list"; glyph: Model.Glyph.trash; kind: "ghost"; compact: true; onClicked: root.removeFromList() }
    }
  }
}
