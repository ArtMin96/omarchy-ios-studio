#!/bin/bash
# iOS Studio MCP server for AI coding agents (stdio). Register this file's absolute path as the server
# command in your agent; see docs/mcp.md.
#
# stdout is the MCP protocol, so everything this script prints goes to stderr. On first run (and whenever
# mcp/requirements.lock or mcp/pyproject.toml changes) it creates a private venv with the server's dependencies,
# exactly as pinned and hashed in the lock, using uv if it's installed, else python -m venv + pip.
#   IOSSTUDIO_DEMO=1        made-up account, iPhone and projects (no real side effects)
#   IOSSTUDIO_MCP_LOG=DEBUG more detail on stderr
#   IOSSTUDIO_MCP_VENV=dir  use another venv location
#   --prepare               only create or update the venv, then exit (Settings › AI agents › Prepare)
set -euo pipefail
self="$(readlink -f "${BASH_SOURCE[0]}")"
repo="$(cd "$(dirname "$self")/.." && pwd)"
pkg="$repo/mcp"
venv="${IOSSTUDIO_MCP_VENV:-${XDG_DATA_HOME:-$HOME/.local/share}/ios-studio/mcp-venv}"
stamp="$venv/.iosstudio-deps"
say() { printf 'iosstudio-mcp: %s\n' "$*" >&2; }

# The dependencies are pinned with hashes in mcp/requirements.lock (docs/mcp.md#dependencies). The stamp is a hash
# of that lock and pyproject.toml, so a normal start only reads two small files: no Python, no network.
lock="$pkg/requirements.lock"
[[ -r $lock ]] || { say "missing $lock: reinstall iOS Studio"; exit 1; }
want="$(cat "$pkg/pyproject.toml" "$lock" | sha256sum | cut -c1-16)"
if [[ ! -x $venv/bin/python || "$(cat "$stamp" 2>/dev/null || true)" != "$want" ]]; then
  mkdir -p "$(dirname "$venv")"
  exec 9>"$venv.lock"
  flock 9   # two agents starting at once: one sets up, the other waits
  if [[ ! -x $venv/bin/python || "$(cat "$stamp" 2>/dev/null || true)" != "$want" ]]; then
    say "setting up the server's Python environment in $venv (first run only, needs internet)…"
    rm -f "$stamp"   # a setup that stops halfway is redone on the next start
    if command -v uv >/dev/null 2>&1; then
      uv venv --quiet --allow-existing --python ">=3.11" "$venv" >&2
      # sync: exactly the locked packages (removes ones an older lock had); every file must match its hash
      VIRTUAL_ENV="$venv" uv pip sync --quiet --require-hashes "$lock" >&2
    else
      # -I: a stray venv.py or pip/ in the agent's working directory is never imported
      [[ -x $venv/bin/python ]] || python3 -I -m venv "$venv" >&2
      "$venv/bin/python" -I -m pip install --quiet --disable-pip-version-check --require-hashes --no-deps \
        -r "$lock" >&2
    fi
    echo "$want" >"$stamp"
    say "ready."
  fi
  exec 9>&-
fi

[[ ${1:-} == --prepare ]] && exit 0

# PYTHONSAFEPATH: never import from the agent's working directory (a stray mcp.py there must not win).
# PYTHONPYCACHEPREFIX: compiled modules go to the user's cache, not the repo.
export PYTHONPATH="$pkg" PYTHONSAFEPATH=1 IOSSTUDIO_REPO="$repo" \
  PYTHONPYCACHEPREFIX="${XDG_CACHE_HOME:-$HOME/.cache}/ios-studio/pycache"
exec "$venv/bin/python" -m iosstudio_mcp "$@"
